; Copy this file to credentials.ini (same folder) and fill in real values,
; or set the equivalent environment variables instead (see config.py).
; credentials.ini is gitignored - never commit real credentials.

[cisco_default]
; Primary/service-account credentials used first for every device.
username = svc-cisco-automation
password =
enable_password =

[cisco_local]
; Optional fallback used only if the service account fails to
; authenticate (e.g. AAA server down, account locked/expired).
; Leave username/password blank to disable the fallback.
username =
password =
enable_password =

; Additional local accounts can be added as numbered sections and are
; tried in order, one at a time, after [cisco_local]. Only sections with
; both a username and password are used - leave a section out entirely
; (or blank) if you don't need it. Up to [cisco_local5] is supported.
;
; [cisco_local2]
; username =
; password =
; enable_password =
;
; [cisco_local3]
; username =
; password =
; enable_password =
